 
<?xml version="1.0"?>
<!--
  Robotics Roadmap 1 - Week 10
  URDF and Gazebo Differential-Drive Robot

  Demonstrates links, joints, geometry,
  inertial properties and Gazebo control.
  Educational reconstruction.
-->

<robot name="roadmap_diff_drive">

  <!-- Main chassis -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.30 0.20 0.08"/>
      </geometry>
      <material name="blue">
        <color rgba="0.1 0.3 0.8 1"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <box size="0.30 0.20 0.08"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.003867" ixy="0" ixz="0"
               iyy="0.008033" iyz="0"
               izz="0.010833"/>
    </inertial>
  </link>

  <!-- Left wheel -->
  <link name="left_wheel">
    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.02"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.00006583" ixy="0" ixz="0"
               iyy="0.000125" iyz="0"
               izz="0.00006583"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.12 -0.025"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Right wheel -->
  <link name="right_wheel">
    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.02"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.00006583" ixy="0" ixz="0"
               iyy="0.000125" iyz="0"
               izz="0.00006583"/>
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.12 -0.025"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Rear support caster -->
  <link name="caster">
    <visual>
      <geometry>
        <sphere radius="0.025"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.025"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0000125" ixy="0" ixz="0"
               iyy="0.0000125" iyz="0"
               izz="0.0000125"/>
    </inertial>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster"/>
    <origin xyz="-0.12 0 -0.05"/>
  </joint>

  <!-- Gazebo Classic differential-drive plugin -->
  <gazebo>
    <plugin name="diff_drive"
            filename="libgazebo_ros_diff_drive.so">

      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>

      <wheel_separation>0.24</wheel_separation>
      <wheel_diameter>0.10</wheel_diameter>

      <max_wheel_torque>5.0</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>

      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>

      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
    </plugin>
  </gazebo>

</robot>
